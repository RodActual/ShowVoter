rules_version = '2';

// Only the shared app account (email/password sign-in) can read or write.
// The email must match VITE_LOGIN_EMAIL in Vercel, in lowercase. Publish with:
//   Firebase console → Firestore Database → Rules, or `npx firebase-tools deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isApp() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'anthony15s.email@gmail.com';
    }

    match /couples/{coupleId}/{collection}/{docId} {
      allow read, write: if isApp() && collection in ['toWatch', 'watched', 'settings', 'votes'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

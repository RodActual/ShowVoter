PORT=4000

# TMDB API key, kept server-side only. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Shared secret required on every API/WebSocket request. Leave blank to disable auth
# (fine for local-only use), or set a long random value and put the same value in
# the project root .env as VITE_APP_TOKEN if you expose this server to the internet.
APP_TOKEN=

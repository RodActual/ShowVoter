PORT=4000

# TMDB API key, kept server-side only. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Shared password for the app. Leave blank to disable sign-in (only for a server
# reachable from your home network alone). Set it before exposing the server to the internet.
APP_PASSWORD=

# Set to true if HTTPS is terminated by something that doesn't send X-Forwarded-Proto.
COOKIE_SECURE=

# Copy to .env.local for local dev. In production these are set in Vercel → Project → Settings → Environment Variables.

# Firebase web config (public by design; Firestore rules enforce access).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email of the one shared Firebase Auth account (Email/Password provider). Not a secret.
VITE_LOGIN_EMAIL=

# Optional: Firestore path segment under couples/ (default: pamrod).
VITE_COUPLE_ID=

# Server-only (Vercel function api/tmdb). Never prefix with VITE_.
TMDB_API_KEY=
